<?xml version="1.0" encoding="utf-8"?>
<!--
  CI feeds just-built Authagonal.* packages into ./nupkgs so demo Dockerfiles can
  restore them immediately, without waiting for nuget.org's v3-flatcontainer to
  index a fresh push (typically 4–6 min). Locally the directory is empty/absent
  and NuGet falls through to nuget.org as normal.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nupkgs" value="./nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Which feed may supply which package. Without this, NuGet queries EVERY source for EVERY package
    and takes the best match, so the local folder — listed first, and writable by whatever produced
    it — could satisfy a request for any third-party dependency, and conversely a package named
    Authagonal.* pushed to nuget.org by anyone could satisfy a restore meant for the local build.
    That is the dependency-confusion shape: the Authagonal.* prefix is ours and comes from the local
    feed during CI; everything else comes from nuget.org and nowhere else.
  -->
  <packageSourceMapping>
    <packageSource key="local-nupkgs">
      <package pattern="Authagonal.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!--
        Authagonal.* is listed here too because these packages really are published to nuget.org —
        the local folder is only CI's fast path while the push indexes. Both sources may serve the
        prefix; what the mapping stops is the reverse, which is the dependency-confusion direction:
        the local folder cannot satisfy a request for ANY third-party package, so a file dropped in
        ./nupkgs named Npgsql or AWSSDK.S3 is never considered.
      -->
      <package pattern="Authagonal.*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Every package must carry a signature from a signer named below. Source mapping decides which feed
    is ASKED for a package; it says nothing about what comes back. Without this, a poisoned local
    NuGet cache, a MITM on an unsigned mirror, or a tampered .nupkg in ./nupkgs is indistinguishable
    from a genuine download — the restore accepts whatever bytes arrive under the right name. Since
    both sources are permitted to serve the Authagonal.* prefix, that is the direction source mapping
    explicitly cannot close.

    nuget.org repository-signs every package it serves, so requiring it costs nothing there.
  -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!--
    The nuget.org repository signing certificates, as published by the service itself at
    api.nuget.org/v3-index/repository-signatures/5.0.0/index.json. All three are listed because
    packages signed under a retired certificate stay valid — the signature is timestamped, so a
    package signed in 2019 still verifies against the 2018 certificate long after it expired.
    Regenerate with `dotnet nuget trusted-signers add`, passing the nuget.org source.
  -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
