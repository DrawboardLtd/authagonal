<?xml version="1.0" encoding="utf-8"?>
<!--
  CI feeds just-built Authagonal.* packages into ./nupkgs so demo Dockerfiles can
  restore them immediately, without waiting for nuget.org's v3-flatcontainer to
  index a fresh push (typically 4–6 min). Locally the directory is empty/absent
  and NuGet falls through to nuget.org as normal.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-nupkgs" value="./nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    Which feed may supply which package. Without this, NuGet queries EVERY source for EVERY package
    and takes the best match, so the local folder — listed first, and writable by whatever produced
    it — could satisfy a request for any third-party dependency, and conversely a package named
    Authagonal.* pushed to nuget.org by anyone could satisfy a restore meant for the local build.
    That is the dependency-confusion shape: the Authagonal.* prefix is ours and comes from the local
    feed during CI; everything else comes from nuget.org and nowhere else.
  -->
  <packageSourceMapping>
    <packageSource key="local-nupkgs">
      <package pattern="Authagonal.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!--
        Authagonal.* is listed here too because these packages really are published to nuget.org —
        the local folder is only CI's fast path while the push indexes. Both sources may serve the
        prefix; what the mapping stops is the reverse, which is the dependency-confusion direction:
        the local folder cannot satisfy a request for ANY third-party package, so a file dropped in
        ./nupkgs named Npgsql or AWSSDK.S3 is never considered.
      -->
      <package pattern="Authagonal.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
