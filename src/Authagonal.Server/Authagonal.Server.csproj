<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Authagonal.Core\Authagonal.Core.csproj" />
    <ProjectReference Include="..\Authagonal.Protocol\Authagonal.Protocol.csproj" />
    <ProjectReference Include="..\Authagonal.AzureProvider\Authagonal.AzureProvider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.0" />
    <!-- Encrypts the persisted DataProtection key ring. Its sibling above only PERSISTS the ring;
         without this the keys that protect the authentication cookie sat in the store as plaintext. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.5.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.9.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <!-- Patch floor, not a pin. 9.0.0 admits runtimes carrying an unauthenticated request-smuggling
         bypass and three unauthenticated DoS CVEs; a net9.0 consumer restoring the old floor got them
         silently. Bracketed above the current security patch and below the next major, and the two
         numbers are deliberately the same ones RuntimeVersionFloor asserts — the floor is one
         statement, not three. net10.0 was an exact 10.0.5, which is the opposite of a floor: it
         forbade the five security releases that followed it rather than requiring them. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[9.0.18,10.0.0)" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[10.0.10,11.0.0)" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- The whole Microsoft.IdentityModel family on one version ($(IdentityModelVersion), set in
         Directory.Build.props). The last three were previously left transitive and resolved to
         8.0.1 behind JwtBearer's pin, alongside an 8.17.0 .Tokens in the same validation
         pipeline. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="$(IdentityModelVersion)" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <!-- Pin transitive to fix CVE GHSA-73j8-2gch-69rq -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.*" />
    <!-- System.Security.Cryptography.Xml is NOT referenced here, deliberately.
         It used to be, pinned to fix GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf (the EncryptedXml
         infinite loop and uncontrolled resource consumption, both reachable from SamlResponseParser),
         with NoWarn=NU1510 to silence the pruning warning. The pin never reached anyone: this is an
         Sdk.Web project whose FrameworkReference already supplies the assembly from
         Microsoft.AspNetCore.App, so the SDK prunes the dependency out of the produced nuspec —
         verified absent from every published package back to 0.2.4 — and NU1510 was exactly the
         diagnostic reporting that. It also quietly downgraded the net10.0 graph to the 9.x package.
         The guarantee that actually holds is the runtime floor: RuntimeVersionFloor asserts it at
         startup, at 9.0.18 / 10.0.10 — the current security patch of each supported major, not just
         the release that carried the XML pair — where a consumer can act on it.
         A non-Web project that genuinely needs the standalone package should reference it itself. -->
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Authagonal.Server</PackageId>
    <Description>Drop-in authentication server for ASP.NET Core. OAuth 2.0, OIDC, SAML SSO, and admin APIs.</Description>
    <Authors>Authagonal</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/authagonal/authagonal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/authagonal/authagonal</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Authagonal.Tests" />
  </ItemGroup>

</Project>
