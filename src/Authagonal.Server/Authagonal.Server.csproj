<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Authagonal.Core\Authagonal.Core.csproj" />
    <ProjectReference Include="..\Authagonal.Protocol\Authagonal.Protocol.csproj" />
    <ProjectReference Include="..\Authagonal.AzureProvider\Authagonal.AzureProvider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.0" />
    <!-- Encrypts the persisted DataProtection key ring. Its sibling above only PERSISTS the ring;
         without this the keys that protect the authentication cookie sat in the store as plaintext. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.5.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.9.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <!-- Patch floor, not a pin. 9.0.0 admits runtimes carrying an unauthenticated request-smuggling
         bypass and three unauthenticated DoS CVEs; a net9.0 consumer restoring the old floor got them
         silently. Bracketed above the fixed versions and below the next major. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[9.0.14,10.0.0)" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.17.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <!-- Pin transitive to fix CVE GHSA-73j8-2gch-69rq -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.*" />
    <!-- Pin transitive to fix CVE GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf.
         NoWarn=NU1510: the framework would prune this for Sdk.Web consumers, but downstream
         non-Web test/tool projects need the explicit pin to avoid the vulnerable 8.0.2. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.*" NoWarn="NU1510" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <IsPackable>true</IsPackable>
    <PackageId>Authagonal.Server</PackageId>
    <Description>Drop-in authentication server for ASP.NET Core. OAuth 2.0, OIDC, SAML SSO, and admin APIs.</Description>
    <Authors>Authagonal</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/authagonal/authagonal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/authagonal/authagonal</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Authagonal.Tests" />
  </ItemGroup>

</Project>
