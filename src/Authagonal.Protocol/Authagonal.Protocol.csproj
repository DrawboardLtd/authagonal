<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Authagonal.Protocol</PackageId>
    <Description>Embeddable OIDC / OAuth 2.0 protocol surface extracted from Authagonal.Server. Plug in your own user identity via IOidcSubjectResolver and storage via IClientStore / IGrantStore / IScopeStore / ISigningKeyStore — no user store, no SAML, no admin UI.</Description>
    <Authors>Authagonal</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/authagonal/authagonal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/authagonal/authagonal</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Authagonal.Core\Authagonal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole Microsoft.IdentityModel family on one version ($(IdentityModelVersion), set in
         Directory.Build.props). The last three were previously left transitive and resolved to
         8.0.1 behind JwtBearer's pin, alongside an 8.17.0 .Tokens in the same validation
         pipeline. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="$(IdentityModelVersion)" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="$(IdentityModelVersion)" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="$(IdentityModelVersion)" />
    <!-- Patch floor, not a pin — the same bracket Authagonal.Server carries. 9.0.0 admits runtimes
         with an unauthenticated request-smuggling bypass and three unauthenticated DoS CVEs, and
         this package is published to nuget.org, so a net9.0 consumer restoring the old floor got
         them silently. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[9.0.14,10.0.0)" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Authagonal.Tests" />
    <InternalsVisibleTo Include="Authagonal.Server" />
  </ItemGroup>

</Project>
