<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Authagonal.Server\Authagonal.Server.csproj" />
    <!-- The storage providers the shipped image can select between at runtime. They live here rather
         than on Authagonal.Server so the library package doesn't force Npgsql and the SQLite native
         binaries onto Azure- or AWS-only consumers. -->
    <ProjectReference Include="..\Authagonal.AzureProvider\Authagonal.AzureProvider.csproj" />
    <ProjectReference Include="..\Authagonal.SqlProvider\Authagonal.SqlProvider.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <!-- The deployable, not a package: Authagonal.Server is the library people reference. -->
    <IsPackable>false</IsPackable>
    <AssemblyName>Authagonal.Host</AssemblyName>
    <RootNamespace>Authagonal.Host</RootNamespace>
  </PropertyGroup>

</Project>
