<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.5" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.*" />
    <PackageReference Include="Testcontainers.DynamoDb" Version="4.*" />
    <!-- Unify with the product projects' Azure.Storage.Blobs 12.* (Testcontainers.Azurite drags in an
         older 12.29.0, which otherwise conflicts with AzureProvider's compiled version). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Authagonal.Core\Authagonal.Core.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.AzureProvider\Authagonal.AzureProvider.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.AwsProvider\Authagonal.AwsProvider.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.Backup\Authagonal.Backup.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.Server\Authagonal.Server.csproj" />
  </ItemGroup>

</Project>