FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY *.slnx ./
# The CLI now drives the shared Authagonal.Migration engine, which pulls in Server (+ Protocol) and the
# AzureProvider — copy each csproj so restore can resolve the graph before the full source copy.
COPY src/Authagonal.Core/*.csproj src/Authagonal.Core/
COPY src/Authagonal.Protocol/*.csproj src/Authagonal.Protocol/
COPY src/Authagonal.AzureProvider/*.csproj src/Authagonal.AzureProvider/
COPY src/Authagonal.Server/*.csproj src/Authagonal.Server/
COPY src/Authagonal.Migration/*.csproj src/Authagonal.Migration/
COPY tools/Authagonal.Migration.Cli/*.csproj tools/Authagonal.Migration.Cli/
RUN dotnet restore tools/Authagonal.Migration.Cli/
COPY src/ src/
COPY tools/ tools/
RUN dotnet publish tools/Authagonal.Migration.Cli/ -c Release -o /app/publish --no-restore

# aspnet (not runtime): the engine references Authagonal.Server, which needs the ASP.NET shared framework.
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
# Runs as a non-root user. The image ran as root, so a remote-code-execution bug anywhere in the
# identity provider began with uid 0 inside the container — and with it the ability to write the
# application binaries, read every mounted secret, and use any capability the runtime retained.
# The aspnet base image ships this uid; it owns nothing, which is the point.
USER $APP_UID

ENTRYPOINT ["dotnet", "Authagonal.Migration.Cli.dll"]
