<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Authagonal.Core\Authagonal.Core.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.Server\Authagonal.Server.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.AzureProvider\Authagonal.AzureProvider.csproj" />
    <ProjectReference Include="..\..\src\Authagonal.Migration\Authagonal.Migration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <!-- Pinned HERE, not inherited. This is a plain Microsoft.NET.Sdk project, so it resolves the
         standalone package rather than taking the assembly from Microsoft.AspNetCore.App — and
         without a floor it lands on the vulnerable 8.0.2 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf
         and others). Authagonal.Server used to carry this pin on its behalf, which worked inside the
         repository and was silently pruned out of every published package, so consumers never got
         it. A pin belongs in the project that actually restores the package. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Authagonal.Migration.Cli</AssemblyName>
    <RootNamespace>Authagonal.Migration.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
